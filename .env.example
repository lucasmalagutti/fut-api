# Copie para .env: cp .env.example .env  (ou copy no Windows)

PORT=3000
HOST=0.0.0.0
DATABASE_URL=file:./prisma/dev.db

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Mailtrap Email Sandbox — https://mailtrap.io → Sandboxes → sua inbox → Integration → SMTP
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=seu_username_smtp_do_mailtrap
MAIL_PASS=sua_password_smtp_do_mailtrap
MAIL_FROM=FutMatch <no-reply@futmatch.app>
# APP_URL=http://192.168.1.6:8081

# Stripe — pagamentos, cartões, PIX e saques Connect
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Dev: stripe listen --forward-to localhost:3000/payments/webhook/stripe

DEFAULT_FEE_RATE=0.1
REFUND_WINDOW_HOURS=24
